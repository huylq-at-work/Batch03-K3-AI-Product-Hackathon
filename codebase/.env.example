# Copy sang .env.local rồi điền. .env.local ĐÃ nằm trong .gitignore.
#
# ⚠️ Vite nhúng mọi biến VITE_* vào bundle JS. Trong browser, API key là PUBLIC —
#    ai mở DevTools cũng đọc được. Chỉ chạy local, KHÔNG deploy. Xem README §Bảo mật.

# mock | anthropic | openai | gemini   (mặc định mock — chạy được không cần key)
VITE_LLM_PROVIDER=mock

# --- Anthropic ---
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI ---
# Lab04 chốt gpt-4o-mini từ v0→v3 "để metric before/after so sánh được".
# Nếu muốn so số với Lab04 thì đặt gpt-4o-mini, đừng để gpt-4o.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o
# Bỏ trống = api.openai.com. Đổi sang OpenRouter như Lab04 đã làm:
#   VITE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   VITE_OPENAI_MODEL=openai/gpt-4o-mini
VITE_OPENAI_BASE_URL=

# --- Google AI Studio (Gemini) ---
# Free tier ~1.500 req/ngày. Lưu ý 02-guide.md §3.4: free tier có thể dùng dữ
# liệu để huấn luyện → đừng dùng cho khảo sát người thật mà không nói trước.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash

# --- eval/runner.ts chạy trong Node: KHÔNG dùng tiền tố VITE_ ---
# LLM_PROVIDER=anthropic          # mock | anthropic | openai | gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
